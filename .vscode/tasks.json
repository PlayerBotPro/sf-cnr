{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-normal",
      "dependsOrder": "sequence",
      "dependsOn": [
        "sampctl: build gamemode",
        "sampctl: build npc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "sampctl: ensure dependencies",
      "type": "process",
      "command": "sampctl",
      "args": [
        "ensure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "test: Pawn compatibility",
      "type": "process",
      "command": "python",
      "args": [
        "tools/server.py",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "sampctl: build gamemode",
      "type": "process",
      "command": "sampctl",
      "args": [
        "build",
        "gamemode"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "sampctl: build npc",
      "type": "process",
      "command": "sampctl",
      "args": [
        "build",
        "npc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
