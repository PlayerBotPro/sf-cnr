{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-normal",
      "type": "process",
      "command": "python",
      "args": [
        "tools/server.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "sampctl: ensure dependencies",
      "type": "process",
      "command": "sampctl",
      "args": [
        "ensure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "test: Pawn compatibility",
      "type": "process",
      "command": "python",
      "args": [
        "tools/server.py",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
